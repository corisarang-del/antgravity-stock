# ⚠️ 이 파일은 예시용입니다. 실제 값은 .env 파일에 저장하세요.
# ⚠️ .env 파일은 절대 git에 커밋하지 마세요! (.gitignore에 포함되어 있습니다)

# ==========================
# Supabase (서버사이드 전용)
# ==========================
# Supabase 프로젝트 대시보드 > Settings > API 에서 확인
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key  # 절대 프론트엔드에 노출 금지!

# ==========================
# Google Gemini API
# ==========================
# https://aistudio.google.com/app/apikey 에서 발급
# 비용 최소화: gemini-2.0-flash 모델 사용, 일기는 1일 1회 생성 후 DB 캐싱
GEMINI_API_KEY=your-gemini-api-key  # 절대 프론트엔드에 노출 금지!

# ==========================
# DART OpenAPI (IPO 일정)
# ==========================
# https://opendart.fss.or.kr 에서 발급 (무료)
DART_API_KEY=your-dart-api-key

# ==========================
# 앱 설정
# ==========================
APP_ENV=development  # development | production
CORS_ORIGINS=http://localhost:3000  # 프로덕션 시 실제 도메인으로 변경

# ==========================
# 캐싱 설정 (비용 최소화)
# ==========================
DIARY_CACHE_HOURS=24        # 개미의 일기: 24시간마다 재생성 (Gemini 호출 절약)
SENTIMENT_CACHE_MINUTES=30  # 감성 분석: 30분마다 업데이트
STOCK_CACHE_MINUTES=15      # 주가 데이터: 장 마감 후 15분 캐싱
